# --- YouTube (works with no configuration) ---
# Links are handled by the yt-dlp + ffmpeg binaries that npm install puts in bin/.
# Hard cap on the resolution that gets fetched (pixels, height).
YOUTUBE_MAX_HEIGHT=1080

# --- Optional persistent backend (use when hosting the UI on Vercel) ---
# Deploy the Dockerfile to Render, then set this to its service URL. Jobs and
# downloads run on that persistent service, not inside Vercel serverless functions.
# DOWNLOADER_BACKEND_URL=https://your-render-service.onrender.com
# Set to 1 before npm install to skip the ~160 MB ffmpeg download (a system
# ffmpeg on PATH is used instead).
# SKIP_FFMPEG_DOWNLOAD=1

# --- TikTok (works with no configuration on a home network) ---
# Public posts are fetched by the same yt-dlp binary, so there is no key to add.
# TikTok screens the network asking, so hosting/cloud IPs and some regions get
# refused; that shows up as a clear error rather than a silent failure.
# Optional: path to a Netscape cookies.txt exported from a browser you are signed
# into, used only for posts that account can already see (region/login gated).
# TIKTOK_COOKIES_FILE=C:\secrets\tiktok-cookies.txt
# Hard cap on the resolution fetched for TikTok posts (pixels, height).
TIKTOK_MAX_HEIGHT=1080

# --- Facebook (optional Graph API fallback) ---
# Page credentials for a Facebook Page you own/manage.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Instagram (optional Graph API fallback) ---
# Meta Graph API credentials for an Instagram Business or Creator account you own/manage.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

META_GRAPH_API_VERSION=v23.0
